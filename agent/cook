#!/usr/bin/env bash
set -euo pipefail

root=$(CDPATH='' cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
project="$root"
managed="$root/.agent-cook/tools"
uv_version=$(< "$project/.uv-version")
python="$project/.venv/bin/python"
export UV_PROJECT_ENVIRONMENT="$project/.venv"

find_uv() {
    local candidate version major minor patch
    local required_major required_minor required_patch
    IFS=. read -r required_major required_minor required_patch <<< "$uv_version"
    for candidate in "${AGENT_COOK_UV:-}" "$managed/uv" "$root/../.agent-cook/tools/uv" "$(command -v uv || true)"; do
        [[ -x "$candidate" ]] || continue
        version=$("$candidate" --version) || continue
        [[ "$version" =~ ^uv[[:space:]]+([0-9]+)\.([0-9]+)\.([0-9]+)([[:space:]]|$) ]] || continue
        major=${BASH_REMATCH[1]} minor=${BASH_REMATCH[2]} patch=${BASH_REMATCH[3]}
        if (( major == required_major && (minor > required_minor || (minor == required_minor && patch >= required_patch)) )); then
            printf '%s\n' "$candidate"
            return
        fi
    done
    return 1
}

install_uv() (
    installer=$(mktemp)
    trap 'rm -f -- "$installer"' EXIT
    url="https://astral.sh/uv/$uv_version/install.sh"
    mkdir -p -- "$managed"
    if command -v curl >/dev/null; then
        curl -fsSL --retry 2 --connect-timeout 10 "$url" -o "$installer"
    elif command -v wget >/dev/null; then
        wget -qO "$installer" "$url"
    else
        echo "Install curl or wget to download uv." >&2
        exit 1
    fi
    UV_UNMANAGED_INSTALL="$managed" sh "$installer"
)

install_environment() {
    local uv
    if ! uv=$(find_uv); then
        echo "Installing uv $uv_version …" >&2
        install_uv
        uv=$(find_uv) || { echo "Could not find uv after installation." >&2; exit 1; }
    fi
    echo "Installing Agent Cook with Python $(< "$project/.python-version") …" >&2
    "$uv" sync --project "$project" --locked --python "$(< "$project/.python-version")" --extra examples --extra server --extra e2b || {
        echo "Could not install the locked Python dependencies for '$project'. See the uv error above." >&2
        return 1
    }
    export AGENT_COOK_UV="$uv"
}

launch() {
    if [[ ! -x "$python" ]]; then
        echo "Run bash ./install from '$project' to set up Agent Cook." >&2
        exit 1
    fi
    local config="$root/.env"
    if [[ ! -f "$config" ]]; then
        config="$root/../.env"
    fi
    if [[ -f "$config" ]]; then
        local uv env_file
        uv=$(find_uv) || { echo "Run bash ./install from '$project' to restore uv for .env loading." >&2; exit 1; }
        # uv splits this option on whitespace even when the shell passes it as one argument.
        env_file=$("$python" -I -c '
import re
import sys

print(re.sub(r"[\s\\]", lambda match: "\\" + match[0], sys.argv[1]))
' "$config")
        export AGENT_COOK_UV="$uv"
        exec "$uv" run --project "$project" --no-sync --env-file "$env_file" "$python" -I "$@"
    fi
    exec "$python" -I "$@"
}

case "${1:-}" in
    setup)
        shift
        if [[ "${1:-}" == --launch ]]; then
            shift
            install_environment
            if [[ "${1:-}" == --global ]]; then
                shift
                exec "$python" -I -m agent_cook install-global "$@"
            fi
            if [[ "${1:-}" == --with-office ]]; then
                shift
                "$python" -I -m agent_cook setup-runtime --with-office
            else
                "$python" -I -m agent_cook setup-runtime
            fi
            launch -m agent_cook "$@"
        fi
        if [[ $# -gt 1 || ($# -eq 1 && "$1" != --docker && "$1" != --with-office) ]]; then
            echo "Usage: ./cook setup [--docker|--with-office]" >&2
            exit 2
        fi
        install_environment
        if [[ "${1:-}" == --docker ]]; then
            launch -m agent_cook docker
        else
            "$python" -I -m agent_cook setup-runtime "$@"
        fi
        ;;
    run)
        shift
        launch -m agent_cook exec "$@"
        ;;
    demo)
        shift
        if [[ $# -eq 0 ]]; then
            set -- quickstart
        fi
        launch "$root/examples/run_demo.py" "$@"
        ;;
    *)
        launch -m agent_cook "$@"
        ;;
esac
