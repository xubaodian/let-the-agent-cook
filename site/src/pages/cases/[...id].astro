---
import type { InferGetStaticPropsType } from "astro"
import { getCollection, render } from "astro:content"
import CaseOutputs from "../../components/CaseOutputs"
import ReplayPlayer from "../../components/ReplayPlayer"
import SiteLayout from "../../layouts/SiteLayout.astro"
import { readableDate, sourceUrl, url } from "../../lib/links"
import { getReplay } from "../../lib/replays"

export async function getStaticPaths() {
  const [cases, notes] = await Promise.all([getCollection("cases"), getCollection("notes")])
  return cases.map((entry) => {
    const related = entry.data.relatedNotes.map((id) => {
      const note = notes.find((candidate) => candidate.id === id)
      if (!note) throw new Error("Missing related note " + id + " for " + entry.id)
      return note
    })
    return { params: { id: entry.id }, props: { entry, related } }
  })
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>
const { entry, related } = Astro.props
const { Content } = await render(entry)
const replay = entry.data.replay ? getReplay(entry.data.replay) : undefined
const previews = replay?.previews.map((preview) => preview.kind === "html"
  ? { ...preview, path: url(preview.path) }
  : { ...preview, slides: preview.slides.map((slide) => ({ ...slide, path: url(slide.path) })) }) ?? []
const downloads = replay?.downloads.map((item) => ({ ...item, path: url(item.path) })) ?? []
---
<SiteLayout title={entry.data.title} description={entry.data.description} current="cases">
  <article class="container case-document">
    <a class="back-link" href={url("cases/")}>← 做出来</a>
    <header class="page-heading">
      <p class="metadata">{entry.data.topic} <span aria-hidden="true">·</span> <time datetime={entry.data.date.toISOString().slice(0, 10)}>{readableDate(entry.data.date)}</time></p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <div class="actions">
        {replay && <a class="button primary" href="#replay">看执行回放 <span aria-hidden="true">↓</span></a>}
        <a class="text-link" href={sourceUrl(entry.data.sourcePath)}>查看示例源码 <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    {replay && <ReplayPlayer client:load steps={replay.steps} />}
    {(previews.length > 0 || downloads.length > 0) && <CaseOutputs client:load {previews} {downloads} />}
    <div class="prose case-body"><Content /></div>
    {entry.data.command && (
      <section class="reproduce" aria-labelledby="reproduce-title">
        <h2 id="reproduce-title">在本地复现</h2>
        {entry.data.setupPath && <p>先按 <a href={sourceUrl(entry.data.setupPath)}>项目安装说明</a> 准备环境，再从仓库根目录运行。</p>}
        <pre><code>{entry.data.command}</code></pre>
      </section>
    )}
    {related.length > 0 && (
      <aside class="related">
        {related.map(({ id, data }) => <a href={url("notes/" + id + "/")}>了解原理 · {data.title} →</a>)}
      </aside>
    )}
  </article>
</SiteLayout>
