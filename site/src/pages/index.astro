---
import { getCollection } from "astro:content"
import EntryList from "../components/EntryList.astro"
import SiteLayout from "../layouts/SiteLayout.astro"
import { newestFirst, sourceUrl, url } from "../lib/links"

const [notes, cases] = await Promise.all([getCollection("notes"), getCollection("cases")])
const weeklyReview = cases.find((entry) => entry.id === "weekly-review")
const description = "我在做 AI Agent，也在学习模型如何被部署和运行。这里记录原理、项目和可以动手复现的案例。"
---
<SiteLayout description={description}>
  <div class="container">
    <section class="hero">
      <div class="hero-copy">
        <h1>Baodian Xu<span aria-hidden="true">.</span></h1>
        <p class="intro">我喜欢把想法做成能用的东西，也把过程写下来。</p>
        <p class="hero-detail">最近在开发 Agent Harness，接下来想多做一些 AI Infra 的实验。</p>
        <div class="actions">
          {weeklyReview && <a class="button primary" href={url("cases/" + weeklyReview.id + "/")}>看看 Agent 怎么做 <span aria-hidden="true">↗</span></a>}
          <a class="text-link" href={url("notes/")}>读原理笔记 <span aria-hidden="true">→</span></a>
        </div>
      </div>
      {weeklyReview && (
        <a class="hero-preview" href={url("cases/" + weeklyReview.id + "/#outputs")} aria-label="预览店铺周报的交付文件">
          <img src={url("replays/weekly-review/dashboard-preview.png")} width="1280" height="720" alt="店铺周报筛选 Mode 类目后显示 US$190,00" fetchpriority="high" />
          <span class="preview-caption"><span>店铺周报 · 网页预览</span><span aria-hidden="true">↗</span></span>
        </a>
      )}
    </section>
    <div class="home-sections">
      <section aria-labelledby="notes-title">
        <div class="section-heading">
          <h2 id="notes-title">想明白</h2>
          <a class="text-link" href={url("notes/")}>全部文章 <span aria-hidden="true">→</span></a>
        </div>
        <EntryList section="notes" entries={notes.sort(newestFirst).slice(0, 3)} />
      </section>
      <section aria-labelledby="cases-title">
        <div class="section-heading">
          <h2 id="cases-title">做出来</h2>
          <a class="text-link" href={url("cases/")}>全部案例 <span aria-hidden="true">→</span></a>
        </div>
        <EntryList section="cases" entries={cases.sort(newestFirst).slice(0, 3)} />
        <a class="project-link" href={sourceUrl("agent/")}><span>Agent Cook 源码与使用说明</span><span aria-hidden="true">↗</span></a>
      </section>
    </div>
  </div>
</SiteLayout>
