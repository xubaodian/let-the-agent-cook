---
import type { CollectionEntry } from "astro:content"
import { readableDate, url } from "../lib/links"

interface Props {
  section: "notes" | "cases"
  entries: (CollectionEntry<"notes"> | CollectionEntry<"cases">)[]
}
const { section, entries } = Astro.props
---
<ul class="entry-list">
  {entries.map(({ id, data }) => (
    <li>
      <a class="entry" href={url(section + "/" + id + "/")}>
        <div class="entry-copy">
          <p class="metadata">{data.topic} <span aria-hidden="true">·</span> <time datetime={data.date.toISOString().slice(0, 10)}>{readableDate(data.date)}</time></p>
          <h3>{data.title}</h3>
          <p>{data.description}</p>
        </div>
        <span class="entry-arrow" aria-hidden="true">↗</span>
      </a>
    </li>
  ))}
</ul>
