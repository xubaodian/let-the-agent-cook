        },
        {
          "path": "replays/weekly-review/slide-3.png",
          "title": "Pemeriksaan berikutnya"
        }
      ]
    },
    {
      "id": "dashboard",
      "kind": "html",
      "label": "筛选网页",
      "path": "replays/weekly-review/dashboard.html",
      "title": "店铺周报筛选网页"
    }
  ],
  "downloads": [
